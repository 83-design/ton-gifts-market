# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Mini App
NEXT_PUBLIC_TMA_URL=https://your-domain.com

# TON Connect
NEXT_PUBLIC_TON_CONNECT_MANIFEST_URL=https://your-domain.com/tonconnect-manifest.json

# TON Network
TON_NETWORK=testnet
TON_API_KEY=your_tonapi_key_here
TON_CENTER_API_KEY=your_toncenter_key_here

# Escrow Wallet (platform wallet for deposits)
ESCROW_WALLET_ADDRESS=UQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ESCROW_WALLET_MNEMONIC=word1 word2 word3 ... word24

# GRAM Jetton
GRAM_MASTER_ADDRESS=EQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App Config
MARKETPLACE_COMMISSION=0.05
DATABASE_URL=file:./dev.db

# Auth Secret (for signing sessions)
AUTH_SECRET=your_random_secret_here_min_32_chars
